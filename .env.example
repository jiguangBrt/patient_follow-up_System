# Application
APP_ENV=development
APP_NAME=patient-follow-up-system
LOG_LEVEL=INFO

# Local SQLite database
DATABASE_URL=sqlite:///./data/app.db

# Demo authentication (replace the secret in local .env; never commit it)
AUTH_SECRET_KEY=replace-with-a-random-local-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Model provider (configured later)
MODEL_PROVIDER=ollama
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=qwen2.5:1.5b
MODEL_API_KEY=ollama

# Online tracing stays disabled unless explicitly configured later
LANGCHAIN_TRACING_V2=false

# Local original files (OCR runs on CPU; it does not use MODEL_* or external APIs)
CLINICAL_UPLOAD_DIR=.local/clinical_uploads
PATIENT_UPLOAD_DIR=.local/patient_uploads
INTAKE_UPLOAD_DIR=.local/intake_uploads

# Stable QR origin; set to the deployed HTTPS origin for take-home printed codes.
# For hotspot testing only, use the computer WLAN IPv4 and test port.
# PUBLIC_BASE_URL=http://10.124.198.137:8011
