# Application
APP_ENV=development
APP_NAME=patient-follow-up-system
LOG_LEVEL=INFO

# Local SQLite database
DATABASE_URL=sqlite:///./data/app.db

# Demo authentication (replace the secret in local .env; never commit it)
AUTH_SECRET_KEY=replace-with-a-random-local-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Model provider (configured later)
MODEL_PROVIDER=ollama
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=qwen2.5:1.5b
MODEL_API_KEY=ollama

# Online tracing stays disabled unless explicitly configured later
LANGCHAIN_TRACING_V2=false
