[Unit]
Description=Patient follow-up application
After=network.target

[Service]
Type=simple
User=patientfollowup
Group=patientfollowup
WorkingDirectory=/srv/apps/patientfollowup/current
EnvironmentFile=/etc/patientfollowup/app.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=2
ExecStart=/srv/apps/patientfollowup/current/.venv/bin/uvicorn patient_follow_up_system.main:app --app-dir src --host 127.0.0.1 --port 8101 --workers 1 --root-path /patientfollowup --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/patientfollowup

[Install]
WantedBy=multi-user.target
